{
  "name": "proofdone",
  "version": "0.1.0",
  "description": "Evidence-based verification CLI for AI coding agents. The agent says \"done\" - ProofDone asks \"prove it\".",
  "license": "MIT",
  "type": "module",
  "bin": {
    "proofdone": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/proofdone.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "examples",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agents",
    "verification",
    "cli",
    "ci",
    "cursor",
    "claude-code",
    "codex",
    "evidence",
    "health-check"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs dist .test-build",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:test": "node scripts/clean.mjs .test-build && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build:test && node --test --test-reporter=spec \".test-build/tests/**/*.test.js\"",
    "selfcheck": "node dist/cli/main.js validate",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run selfcheck",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
